{
  "name": "blog-frontend",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "format": "prettier --write \"src/**/*.{astro,js,jsx,ts,tsx,css,md}\"",
    "lint-staged": "lint-staged",
    "prepare": "cd .. && husky blog-frontend/.husky"
  },
  "lint-staged": {
    "src/**/*.{astro,js,jsx,ts,tsx,css,md}": [
      "prettier --write"
    ]
