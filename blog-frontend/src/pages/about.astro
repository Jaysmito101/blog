---
const email = 'jaysmito101@gmail.com';
const mailtoUrl = `mailto:${email}`;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0;url=${mailtoUrl}`} />
    <title>Redirecting...</title>
  </head>
  <body>
    <p>
      Redirecting to <a href={mailtoUrl}>{email}</a>.
    </p>
    <script is:inline>
      window.location.replace('mailto:jaysmito101@gmail.com');
    </script>
  </body>
</html>
