---
import { SITE_TITLE } from '../consts';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 5);
---

<header>
  <nav>
    <div class="branding">
      <h1><a href="/" data-umami-event="nav-site-title">{SITE_TITLE}</a></h1>
      <button id="theme-toggle" aria-label="Toggle dark mode" data-umami-event="theme-toggle">
        <svg class="sun-icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="5"></circle>
          <line x1="12" y1="1" x2="12" y2="3"></line>
          <line x1="12" y1="21" x2="12" y2="23"></line>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
          <line x1="1" y1="12" x2="3" y2="12"></line>
          <line x1="21" y1="12" x2="23" y2="12"></line>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
        </svg>
        <svg class="moon-icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: none;">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>
    </div>

    <div class="section author">
      <h3>Author</h3>
      <p>
        <strong
          ><a href="mailto:jaysmito101@gmail.com" class="author-name" data-umami-event="nav-author-name">Jaysmito Mukherjee</a></strong
        >
        <a href="mailto:jaysmito101@gmail.com" class="author-email" data-umami-event="nav-author-email">jaysmito101@gmail.com</a>
      </p>
    </div>

    <div class="section navigation">
      <a href="/search" class="search-box" data-umami-event="nav-search">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <span>Search posts...</span>
      </a>
      <h3><a href="/projects" data-umami-event="nav-projects">Work, projects and publications</a></h3>
      <h3>
        <a href="https://github.com/jaysmito101" target="_blank" data-umami-event="nav-github">GitHub</a>
      </h3>
    </div>

    <div class="section posts">
      <h3>Posts</h3>
      <p>
        If you like this blog, you should follow it via <a href="/rss.xml" data-umami-event="nav-rss"
          >RSS</a
        > and read <a href="/blog" data-umami-event="nav-older-posts">older posts</a>. Here are the recent posts.
      </p>
      <ul>
        {
          posts.map((post) => (
            <li>
              <a href={`/blog/${post.id}/`} data-umami-event="nav-recent-post" data-umami-event-title={post.data.title}>{post.data.title}</a>
            </li>
          ))
        }
      </ul>
    </div>
  </nav>
</header>

<script is:inline>
  const updateIcon = (isDark) => {
    const sunIcon = document.querySelector('.sun-icon');
    const moonIcon = document.querySelector('.moon-icon');
    if (sunIcon && moonIcon) {
        if (isDark) {
            sunIcon.style.display = 'block';
            moonIcon.style.display = 'none';
        } else {
            sunIcon.style.display = 'none';
            moonIcon.style.display = 'block';
        }
    }
  }

  const handleToggleClick = () => {
    const element = document.documentElement;
    element.classList.toggle("dark");

    const isDark = element.classList.contains("dark");
    localStorage.setItem("theme", isDark ? "dark" : "light");
    
    updateIcon(isDark);

    // Track theme preference
    if (typeof umami !== 'undefined') {
      umami.track('theme-switch', { theme: isDark ? 'dark' : 'light' });
    }
  };

  document.getElementById("theme-toggle")?.addEventListener("click", handleToggleClick);
  
  // Initial icon state
  const currentTheme = localStorage.getItem('theme') || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
  updateIcon(currentTheme === 'dark');
</script>

<style>
  h1 {
    font-size: 1.5em;
    margin: 0;
    line-height: 1.2;
  }
  h1 a {
    color: #fff;
    text-decoration: none;
  }
  .branding {
    margin-bottom: 2em;
  }
  .search-box {
    display: flex;
    align-items: center;
    gap: 0.5em;
    padding: 0.5em 0.8em;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 4px;
    color: #ccc;
    text-decoration: none;
    margin-bottom: 1.5em;
    transition: background 0.2s, color 0.2s;
  }
  .search-box:hover {
     background: rgba(255, 255, 255, 0.2);
     color: #fff;
     text-decoration: none;
  }
  .section {
    margin-bottom: 2em;
  }
  h3 {
    font-size: 0.85em;
    text-transform: uppercase;
    color: #ccc; /* Improved contrast */
    margin-bottom: 0.5em;
    letter-spacing: 0.05em;
    font-weight: normal;
  }
  h3 a {
    color: #ccc; /* Improved contrast */
    text-decoration: none;
  }
  h3 a:hover {
    color: #fff;
    text-decoration: underline;
  }
  p {
    font-size: 0.9em;
    color: #bbb; /* Improved contrast */
    margin: 0 0 1em 0;
    line-height: 1.5;
  }
  .author-name {
    color: #fff; /* Improved contrast */
    text-decoration: none;
  }
  .author-name:hover {
    color: #fff;
    text-decoration: underline;
  }
  .tiny-link {
    font-size: 0.85em;
    color: var(--link-color);
    text-decoration: none;
  }
  .tiny-link:hover {
    text-decoration: underline;
  }
  ul {
    list-style: disc;
    padding-left: 1.2em;
    margin: 0;
  }
  li {
    margin-bottom: 0.3em;
    color: #bbb; /* Improved contrast */
  }
  li a {
    color: #ddd; /* Improved contrast */
    text-decoration: none;
  }
  li a:hover {
    color: #fff;
    text-decoration: underline;
  }

  /* Theme Toggle fixed to top-right */
  #theme-toggle {
    position: fixed;
    top: 2rem;
    right: 2rem;
    z-index: 100;
    background: var(--content-bg); /* Use content bg to stand out or blend with main area? */
    border: 1px solid var(--blockquote-border);
    border-radius: 50%;
    width: 40px;
    height: 40px;
    cursor: pointer;
    color: var(--content-text);
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 5px rgba(0,0,0,0.2);
  }
  
  #theme-toggle:hover {
    background: var(--code-bg);
  }

  @media (max-width: 768px) {
    nav {
      display: flex;
      flex-direction: column;
      gap: 1em;
    }
    .branding {
      margin-bottom: 0;
    }
    #theme-toggle {
        /* On mobile, keep it relative or fixed? Fixed is fine, or move into header. 
           Let's keep it fixed but adjust position */
        top: 1rem;
        right: 1rem;
    }
    h1 {
      font-size: 1.25em;
      margin: 0;
    }
    .section {
      margin-bottom: 0;
    }
    .section.author p {
      margin: 0;
    }
    .section.navigation h3 {
      display: inline-block;
      margin-right: 1.5em;
      font-size: 1em;
      padding: 0.5em 0; 
    }
    li {
      padding: 0.5em 0; 
      border-bottom: 1px solid #eee;
    }
  }
</style>

